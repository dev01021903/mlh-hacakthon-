# ====================================================
# Environments & Secret Credentials (NEVER COMMIT)
# ====================================================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

backend/.env
backend/.env.*
backend/.env.local
backend/.env.development.local
backend/.env.test.local
backend/.env.production.local
!backend/.env.example

# ====================================================
# Python Exclusions
# ====================================================
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.pypa
.pytest_cache/
.coverage
htmlcov/

# ====================================================
# Node & Build Outputs
# ====================================================
node_modules/
dist/
dist-ssr/
*.local
tsconfig.tsbuildinfo
.npm
.eslintcache

# ====================================================
# Operating System & Logs
# ====================================================
.DS_Store
.DS_Store?
._*
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
